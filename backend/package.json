    "helmet": "^8.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "openai": "^4.104.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.8.2"
  },
  "overrides": {
